# Pit Stop server configuration.
#
# Copy to .env and fill in. .env is gitignored — never commit real keys.
#   cp .env.example .env

# Postgres connection string. Required.
DATABASE_URL=postgres://pitstop:pitstop@localhost:5432/pitstop?sslmode=disable

# Port the server listens on. Optional, defaults to 8080.
PORT=8080

# Shared key the iOS and Android apps send in X-API-Key when submitting a
# score. Required. This value is compiled into both app binaries, so treat it
# as "keeps honest people honest", not as a real secret.
API_KEY=change-me-app-key

# Key that unlocks the /admin moderation view. Required, and must differ from
# API_KEY — the apps must not be able to delete scores.
ADMIN_KEY=change-me-admin-key

# CORS allow-list for the browser leaderboard. Optional, defaults to *.
ALLOWED_ORIGINS=*

# Log verbosity: debug, info, warn or error. Optional, defaults to info.
LOG_LEVEL=info
